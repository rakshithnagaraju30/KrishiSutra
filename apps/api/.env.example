# KrishiSutra API — environment variables.
# Copy to .env and adjust. .env is git-ignored: never commit real credentials.
# Variables are validated at startup; the server refuses to start if a value is missing or invalid.

# --- Application -------------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Interface and port for the HTTP server (PORT=0 picks a free port).
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
# Default: debug (development), silent (test), info (production)
LOG_LEVEL=debug

# --- Database (required) -------------------------------------------------------------------------
# PostgreSQL 16. Matches docker-compose.yml for local development.
DATABASE_URL="postgresql://krishisutra:change_me@localhost:5432/krishisutra?schema=public"
# Optional: how long to wait for a database connection before failing (default 10000 ms).
# DATABASE_CONNECT_TIMEOUT_MS=10000
# Startup check: time per attempt and number of attempts (a sleeping hosted database needs a few seconds).
# DATABASE_CHECK_TIMEOUT_MS=10000
# DATABASE_STARTUP_ATTEMPTS=5

# --- HTTP ----------------------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (the web app). Required in production.
# "*" is not allowed. The Android/iOS app does not need an entry (native apps send no Origin).
# Expo web dev server: http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Maximum JSON request body size.
REQUEST_BODY_LIMIT=100kb
# Behind a load balancer / Cloud Run, set the number of proxy hops (e.g. 1) so client IPs are correct.
TRUST_PROXY=false

# --- Phone sign-in: OTP + JWT (Part 3.2) — see docs/backend/08-authentication.md ---------------
# Secrets: long random values, different from each other (e.g. `openssl rand -base64 48`). NEVER commit them.
# Development/test: if unset, random per-process values are generated (sessions end on restart).
# Production: if unset, phone sign-in is disabled (endpoints answer 503); device accounts keep working.
# JWT_ACCESS_SECRET=
# OTP_HASH_SECRET=
# ACCESS_TOKEN_TTL_SECONDS=900        # access token lifetime (60–3600)
# REFRESH_TOKEN_TTL_DAYS=30           # refresh token lifetime, renewed on each rotation (1–180)
# OTP_LENGTH=6
# OTP_TTL_SECONDS=300                 # code validity
# OTP_MAX_ATTEMPTS=5                  # wrong guesses allowed per code
# OTP_RESEND_COOLDOWN_SECONDS=60      # wait before another code for the same number
# OTP_MAX_PER_PHONE_PER_HOUR=5        # codes per number per hour
# OTP_REQUESTS_PER_HOUR=60            # sign-in requests per client IP per hour
# SMS provider: console (DEVELOPMENT ONLY — prints codes to the log; refused in production) | none.
# Default: console in development, none in production. A real provider (e.g. MSG91/Twilio) is added later.
# SMS_PROVIDER=console

# --- Media storage (used from Part 3.x onwards; listed so configuration lives in one place) -------
# STORAGE_PROVIDER=S3              # S3 | CLOUDINARY | GCS
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT=                     # for S3-compatible stores (e.g. MinIO)
# CLOUDINARY_URL=
