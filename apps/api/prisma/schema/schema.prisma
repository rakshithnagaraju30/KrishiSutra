// KrishiSutra database schema (Prisma ORM 7, PostgreSQL).
//
// The schema is split into one file per module (prisma/schema/*.prisma):
//   00 enums · 01 users · 02 reference data · 03 categories · 04 crops · 05 procedures
//   06 media & content · 07 translation · 08 farms · 09 recommendations · 10 crop lifecycle
//   11 pests & diseases · 12 inputs & expenses · 13 harvest & sales · 14 notifications & community
//
// Conventions
//   * Primary keys: UUIDv7 (time-ordered) generated by Prisma Client, stored as native UUID.
//   * Timestamps: timestamptz; calendar dates (sowing, harvest, test dates) use date.
//   * Money: Decimal(14,2) + ISO-4217 currency (default INR). Areas: Decimal(12,4) + unit.
//   * Quantities always carry a MeasurementUnit; nothing is stored "unit-less".
//   * Agricultural knowledge (crops, procedures, media, ...) never references farmer data.
//   * CHECK constraints that Prisma cannot express live in a hand-written migration
//     (prisma/migrations/*_check_constraints). See docs/database/03-database-architecture.md.

generator client {
  provider        = "prisma-client"
  output          = "../../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}
