// MODULE 11 — Agricultural inputs and expenses
//
// Recommended quantities (InputRecommendation, verified knowledge) are stored separately from what a
// farmer bought (InputPurchase) and actually applied (InputApplicationLog).

/// Catalogue of inputs: seeds, fertilisers, manures, pesticides... createdById = null → curated entry;
/// otherwise added by a farmer for their own records (isVerified stays false).
model FarmInput {
  id                 String    @id @default(uuid(7)) @db.Uuid
  inputType          InputType
  name               String    @db.VarChar(200)
  brandName          String?   @db.VarChar(150)
  manufacturer       String?   @db.VarChar(200)
  activeIngredient   String?   @db.VarChar(300)
  /// e.g. nutrient grade "10-26-26" as printed on the bag.
  composition        String?   @db.VarChar(300)
  /// Registration number (e.g. CIB&RC for pesticides), if applicable.
  registrationNumber String?   @db.VarChar(100)
  defaultUnitId      String?   @db.Uuid
  isVerified         Boolean   @default(false)
  createdById        String?   @db.Uuid
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime? @db.Timestamptz(6)

  defaultUnit MeasurementUnit? @relation(fields: [defaultUnitId], references: [id], onDelete: Restrict)
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  stageResources       StageResource[]
  treatments           DiseaseTreatment[]
  inputRecommendations InputRecommendation[]
  purchases            InputPurchase[]
  applicationLogs      InputApplicationLog[]

  @@index([inputType, name])
  @@index([createdById])
}

/// Verified recommended dose for a crop (optionally variety, stage, region, season), either for a
/// specific product (farmInputId) or for a nutrient (nutrientParameterId, e.g. N in kg/ha).
model InputRecommendation {
  id                  String             @id @default(uuid(7)) @db.Uuid
  cropId              String             @db.Uuid
  cropVarietyId       String?            @db.Uuid
  growingStageId      String?            @db.Uuid
  regionId            String?            @db.Uuid
  seasonId            String?            @db.Uuid
  farmInputId         String?            @db.Uuid
  nutrientParameterId String?            @db.Uuid
  quantityMin         Decimal?           @db.Decimal(12, 4)
  quantityMax         Decimal?           @db.Decimal(12, 4)
  quantityUnitId      String             @db.Uuid
  basis               QuantityBasis
  applicationMethod   ApplicationMethod?
  timingNote          String?
  /// Condition under which it applies, e.g. "if soil-test N is low".
  conditionNote       String?
  sourceId            String?            @db.Uuid
  status              ContentStatus      @default(DRAFT)
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  createdAt           DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(6)

  crop              Crop                @relation(fields: [cropId], references: [id], onDelete: Restrict)
  cropVariety       CropVariety?        @relation(fields: [cropVarietyId, cropId], references: [id, cropId], onDelete: Restrict)
  growingStage      GrowingStage?       @relation(fields: [growingStageId], references: [id], onDelete: Cascade)
  region            Region?             @relation(fields: [regionId], references: [id], onDelete: Restrict)
  season            Season?             @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  farmInput         FarmInput?          @relation(fields: [farmInputId], references: [id], onDelete: SetNull)
  nutrientParameter AgronomicParameter? @relation(fields: [nutrientParameterId], references: [id], onDelete: Restrict)
  quantityUnit      MeasurementUnit     @relation(fields: [quantityUnitId], references: [id], onDelete: Restrict)
  source            ContentSource?      @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  applicationLogs InputApplicationLog[]
  reviews         ContentReview[]

  @@index([cropId, status])
  @@index([growingStageId])
  @@index([farmInputId])
}

model InputPurchase {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @db.Uuid
  farmId        String?   @db.Uuid
  farmInputId   String?   @db.Uuid
  /// Name as on the bill (always kept, even when linked to the catalogue).
  itemName      String    @db.VarChar(200)
  quantity      Decimal   @db.Decimal(14, 3)
  unitId        String    @db.Uuid
  unitPrice     Decimal?  @db.Decimal(14, 2)
  totalAmount   Decimal   @db.Decimal(14, 2)
  currency      String    @default("INR") @db.Char(3)
  purchaseDate  DateTime  @db.Date
  supplierName  String?   @db.VarChar(200)
  receiptFileId String?   @db.Uuid
  notes         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime? @db.Timestamptz(6)

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm        Farm?           @relation(fields: [farmId], references: [id], onDelete: SetNull)
  farmInput   FarmInput?      @relation(fields: [farmInputId], references: [id], onDelete: SetNull)
  unit        MeasurementUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  receiptFile UserFile?       @relation(fields: [receiptFileId], references: [id], onDelete: SetNull)

  applicationLogs InputApplicationLog[]
  expenses        CropExpense[]

  @@index([userId, purchaseDate])
  @@index([farmId])
}

/// Actual application of an input (fertiliser, manure, pesticide...) — detail row of one activity.
/// This is the requested "FertilizerLog", generalised so pesticide sprays do not need a duplicate table.
model InputApplicationLog {
  id                    String             @id @default(uuid(7)) @db.Uuid
  activityLogId         String             @unique @db.Uuid
  farmInputId           String?            @db.Uuid
  inputPurchaseId       String?            @db.Uuid
  /// What the farmer intended to follow, if any (recommendation stays untouched).
  inputRecommendationId String?            @db.Uuid
  productName           String?            @db.VarChar(200)
  quantity              Decimal            @db.Decimal(14, 3)
  unitId                String             @db.Uuid
  applicationMethod     ApplicationMethod?
  areaCovered           Decimal?           @db.Decimal(12, 4)
  areaUnitId            String?            @db.Uuid
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)

  activityLog         CropActivityLog      @relation(fields: [activityLogId], references: [id], onDelete: Cascade)
  farmInput           FarmInput?           @relation(fields: [farmInputId], references: [id], onDelete: SetNull)
  inputPurchase       InputPurchase?       @relation(fields: [inputPurchaseId], references: [id], onDelete: SetNull)
  inputRecommendation InputRecommendation? @relation(fields: [inputRecommendationId], references: [id], onDelete: SetNull)
  unit                MeasurementUnit      @relation("ApplicationQuantityUnit", fields: [unitId], references: [id], onDelete: Restrict)
  areaUnit            MeasurementUnit?     @relation("ApplicationAreaUnit", fields: [areaUnitId], references: [id], onDelete: Restrict)

  @@index([farmInputId])
  @@index([inputPurchaseId])
}

/// Money spent on one cultivation. Soft-deleted only, to preserve financial history.
model CropExpense {
  id              String          @id @default(uuid(7)) @db.Uuid
  farmCropId      String          @db.Uuid
  category        ExpenseCategory
  expenseDate     DateTime        @db.Date
  amount          Decimal         @db.Decimal(14, 2)
  currency        String          @default("INR") @db.Char(3)
  description     String?         @db.VarChar(300)
  quantity        Decimal?        @db.Decimal(14, 3)
  unitId          String?         @db.Uuid
  inputPurchaseId String?         @db.Uuid
  activityLogId   String?         @db.Uuid
  paymentMode     PaymentMode?
  receiptFileId   String?         @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?       @db.Timestamptz(6)

  farmCrop      FarmCrop         @relation(fields: [farmCropId], references: [id], onDelete: Cascade)
  unit          MeasurementUnit? @relation(fields: [unitId], references: [id], onDelete: Restrict)
  inputPurchase InputPurchase?   @relation(fields: [inputPurchaseId], references: [id], onDelete: SetNull)
  activityLog   CropActivityLog? @relation(fields: [activityLogId], references: [id], onDelete: SetNull)
  receiptFile   UserFile?        @relation(fields: [receiptFileId], references: [id], onDelete: SetNull)

  @@index([farmCropId, expenseDate])
  @@index([farmCropId, category])
}
