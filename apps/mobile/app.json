{
  "expo": {
    "name": "KrishiSutra",
    "slug": "krishisutra",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krishisutra.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E7D34",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.krishisutra.app",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KrishiSutra uses your location to show the weather for your farm."
        }
      ]
    ],
    "scheme": "krishisutra",
    "extra": {
      "apiBaseUrl": "https://krishisutra-api.onrender.com"
    }
  }
}
